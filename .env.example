# Copy to .env and adjust. docker compose reads these automatically.
POSTGRES_USER=etl
POSTGRES_PASSWORD=etl
POSTGRES_DB=reporting
DATABASE_URL=postgresql+psycopg://etl:etl@localhost:5432/reporting

# Where the extractor pulls the product catalog and FX rates from.
API_BASE_URL=http://localhost:8000/mock-api
API_MAX_RETRIES=3
# Share of mock-API requests that return 503, to exercise retries (0 disables).
MOCK_API_FAILURE_RATE=0.15

# Seed run history on first start, leaving N monthly files to load live from the UI.
DEMO_BOOTSTRAP=true
DEMO_LEAVE_PENDING=2
